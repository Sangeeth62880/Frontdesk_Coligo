DATABASE_URL=postgresql://frontdesk:frontdesk@localhost:5432/frontdesk
# Replace both placeholders with different random values before running.
FRONTDESK_AGENT_TOKEN=replace-with-random-agent-secret
FRONTDESK_SWEEP_TOKEN=replace-with-different-random-sweep-secret
# Automatic close sweep runs while the application is up; 0 disables it.
FRONTDESK_SWEEP_INTERVAL_SECONDS=60
# Optional deployment bootstrap: separate restricted DB-role password.
# The administrator connection runs migrations; requests then use frontdesk_app.
# FRONTDESK_DB_PASSWORD=replace-with-a-random-database-password
FRONTDESK_SEED_DEMO=true
