DATABASE_URL=postgresql://frontdesk:frontdesk@localhost:5432/frontdesk
# Verification creates and drops isolated schemas; requires CREATE SCHEMA and CREATEROLE.
TEST_DATABASE_URL=postgresql://frontdesk:frontdesk@localhost:5432/frontdesk
# Choose a strong demo password; required only when demo seeding is enabled.
FRONTDESK_DEMO_PASSWORD=replace-with-a-strong-demo-password
FRONTDESK_SWEEP_TOKEN=replace-with-different-random-sweep-secret
# Automatic close sweep runs while the application is up; 0 disables it.
FRONTDESK_SWEEP_INTERVAL_SECONDS=60
# Optional deployment bootstrap: separate restricted DB-role password.
# The administrator connection runs migrations; requests then use frontdesk_app.
# FRONTDESK_DB_PASSWORD=replace-with-a-random-database-password
FRONTDESK_SEED_DEMO=true
# Public intake: per resolved client IP, per ten-minute window. Do not trust arbitrary forwarding headers.
FRONTDESK_INTAKE_LIMIT=10
FRONTDESK_MAX_BODY_BYTES=65536
FRONTDESK_STATEMENT_TIMEOUT_MS=10000
FRONTDESK_LOG_LEVEL=INFO
